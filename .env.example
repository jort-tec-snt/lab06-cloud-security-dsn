# Configuración local de desarrollo. No colocar secretos reales en este archivo.

# PostgreSQL
POSTGRES_DB=securedocs_dev
POSTGRES_USER=securedocs_dev
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432

# API
API_PORT=3000
NODE_ENV=development
JWT_SECRET=securedocs-local-example-secret-change-before-any-deployment-2026
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173

# Frontend
WEB_PORT=5173

# Conexión de la API ejecutada localmente a PostgreSQL publicado por Docker.
# Docker Compose sustituye localhost por el nombre interno del servicio al iniciar api.
DATABASE_URL=postgresql://securedocs_dev:change_me_local_only@localhost:5432/securedocs_dev
